{
  "name": "n8n-nodes-rivoo",
  "version": "0.1.0",
  "description": "n8n community node for the RivooPay payments API: PIX charges, refunds and clients",
  "keywords": [
    "n8n-community-node-package",
    "rivoo",
    "rivoopay",
    "pix",
    "payments"
  ],
  "license": "MIT",
  "author": {
    "name": "Rivoo",
    "email": "contato@rivoopay.com"
  },
  "homepage": "https://github.com/payera-br/n8n-nodes-rivoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payera-br/n8n-nodes-rivoo.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint package.json credentials nodes --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RivooApi.credentials.js",
      "dist/credentials/RivooWebhookApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Rivoo/Rivoo.node.js",
      "dist/nodes/RivooTrigger/RivooTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "n8n-workflow": "*",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
